# CloudTask environment reference (spec §17).
#
# docker-compose.yml sets these per-service already; this file documents every
# variable and is the template for running services directly on the host.
# Copy to `.env` (git-ignored) if you run outside Docker.
#
# Markers:  # secret      -> in AWS this comes from Secrets Manager, never plain
#           # local only  -> must NOT be set in AWS

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://cloudtask:cloudtask@localhost:5432/cloudtask   # secret
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_ENABLED=false
JWT_SECRET=local-dev-only-not-a-real-secret-change-me                  # secret
AWS_REGION=us-east-1
EXPORT_QUEUE_URL=http://localhost:4566/000000000000/cloudtask-exports
EXPORT_BUCKET_NAME=cloudtask-exports-local
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
ENABLE_FAILURE_ENDPOINTS=true                                         # dev only

# LocalStack + dummy AWS credentials (local only; unset in AWS)
AWS_ENDPOINT_URL=http://localhost:4566                                # local only
AWS_ACCESS_KEY_ID=test                                                # local only
AWS_SECRET_ACCESS_KEY=test                                            # local only

# ---------------------------------------------------------------------------
# Worker service (no Redis, no PORT)
# ---------------------------------------------------------------------------
# NODE_ENV=development
# DATABASE_URL=postgres://cloudtask:cloudtask@localhost:5432/cloudtask # secret
# AWS_REGION=us-east-1
# EXPORT_QUEUE_URL=http://localhost:4566/000000000000/cloudtask-exports
# EXPORT_BUCKET_NAME=cloudtask-exports-local
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT_SECONDS=60
# LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Web service
# ---------------------------------------------------------------------------
# NODE_ENV=development
# PORT=3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
